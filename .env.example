# Copy to .env and fill in.
MONGO_URI=mongodb://localhost:27017
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=ashoka_distribution

# Generate a long random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# React dev + your deployed frontend. Comma-separated, or * for all.
CORS_ORIGINS=http://localhost:5173
